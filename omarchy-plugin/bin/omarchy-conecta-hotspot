#!/bin/bash
# omarchy:summary=Control Conecta WiFi hotspot
# omarchy:args=[start|stop|status|clients]
# omarchy:hidden=true
#
# Thin adapter over conecta-cli: passes CLI stdout through verbatim and
# propagates its exit status unchanged. Never synthesizes success.
# Contract: one JSON document on stdout; diagnostics stay on stderr.

set -u

CONNECTA_CLI="${CONNECTA_CLI:-conecta-cli}"

usage_json() {
  printf '%s' '{"ok":false,"error":{"code":"invalid_input","message":"usage: omarchy-conecta-hotspot {start|stop|status|clients}"}}'
}

ACTION="${1:-}"
case "$ACTION" in
  start|stop|status|clients) ;;
  *)
    echo "Usage: $0 {start|stop|status|clients}" >&2
    usage_json
    exit 2
    ;;
esac

out=$("$CONNECTA_CLI" hotspot "$ACTION" 2>/dev/null); rc=$?
printf '%s' "$out"
exit "$rc"
