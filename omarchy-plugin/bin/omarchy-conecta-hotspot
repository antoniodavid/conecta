#!/bin/bash
# omarchy:summary=Control Conecta WiFi hotspot
# omarchy:args=[start|stop|status|clients]
# omarchy:hidden=true
#
# Manages the WiFi hotspot for sharing ETECSA connection.
# Used by the Omarchy bar widget for quick hotspot control.

set -eo pipefail

CONNECTA_CLI="${CONNECTA_CLI:-conecta-cli}"
ACTION="${1:-status}"

case "$ACTION" in
  start)
    "$CONNECTA_CLI" hotspot start 2>/dev/null
    echo '{"action":"start","success":true}'
    ;;
  stop)
    "$CONNECTA_CLI" hotspot stop 2>/dev/null
    echo '{"action":"stop","success":true}'
    ;;
  status)
    if systemctl is-active --quiet create_ap 2>/dev/null; then
      SSID=$(grep "^SSID=" /etc/create_ap.conf 2>/dev/null | cut -d= -f2 || echo "")
      CLIENTS=$(iw dev ap0 station dump 2>/dev/null | grep -c "Station " || echo "0")
      cat <<EOF
{
  "active": true,
  "ssid": "$SSID",
  "clients": $CLIENTS
}
EOF
    else
      echo '{"active":false,"ssid":"","clients":0}'
    fi
    ;;
  clients)
    "$CONNECTA_CLI" hotspot clients 2>/dev/null | awk 'NR>1{print}' || echo "No clients"
    ;;
  *)
    echo "Usage: $0 {start|stop|status|clients}" >&2
    exit 1
    ;;
esac
