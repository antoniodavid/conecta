#!/bin/bash
# omarchy:summary=Print Conecta network status as JSON
# omarchy:args=[--json]
# omarchy:hidden=true
#
# Thin adapter: aggregates conecta-cli JSON documents with jq into the single
# record the panel reads. The CLI owns detection (Wi-Fi signal, VPN
# interface); this script never re-parses `iw`/`ip` text and never evals
# network input. Values stay JSON data via --argjson, so hostile SSIDs cannot
# break the document. Exit status is the first nonzero CLI exit (0 when all
# sections succeed); output is always one compact JSON line.

set -u

CONNECTA_CLI="${CONNECTA_CLI:-conecta-cli}"

cli_json() {
  local out rc
  out=$("$CONNECTA_CLI" "$@" 2>/dev/null); rc=$?
  printf '%s' "$out"
  return "$rc"
}

# valid_or_false <text>: print text when it is a JSON document, else a
# failure stub so merging never breaks on empty/non-JSON output.
valid_or_false() {
  if printf '%s' "$1" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$1"
  else
    printf '{"ok":false}'
  fi
}

status_raw=$(cli_json status); status_rc=$?
hotspot_raw=$(cli_json hotspot status); hotspot_rc=$?
vpn_raw=$(cli_json vpn status); vpn_rc=$?

status_json=$(valid_or_false "$status_raw")
hotspot_json=$(valid_or_false "$hotspot_raw")
vpn_json=$(valid_or_false "$vpn_raw")

merged=$(jq -n -c \
  --argjson st "$status_json" \
  --argjson hs "$hotspot_json" \
  --argjson vn "$vpn_json" \
  '{
    connection: {
      status: ($st.data.status // "error"),
      gateway: ($st.data.gateway // ""),
      interface: ($st.data.interface // ""),
      ssid: ($st.data.wifi.ssid // ""),
      signal: ($st.data.wifi.signal // 0),
      username: ($st.data.username // "")
    },
    hotspot: {
      active: ($hs.data.active // false),
      ssid: ($hs.data.ssid // ""),
      clients: ($hs.data.clients // 0)
    },
    vpn: {
      connected: ($vn.data.connected // false),
      ip: ($vn.data.ip // ""),
      name: ($vn.data.name // ""),
      profiles: ($vn.data.profiles // [])
    },
    timestamp: (now | todate)
  }')
printf '%s' "$merged"

rc=0
for c in "$status_rc" "$hotspot_rc" "$vpn_rc"; do
  if [ "$c" -ne 0 ]; then rc="$c"; break; fi
done
exit "$rc"
