#!/bin/bash
# omarchy:summary=Print Conecta network status as JSON
# omarchy:args=[--json]
# omarchy:hidden=true
#
# Outputs the current ETECSA connection status, hotspot state, and VPN state
# as a single JSON record. The Omarchy bar widget reads this to populate
# the panel.

set -eo pipefail

CONNECTA_CLI="${CONNECTA_CLI:-conecta-cli}"
JSON_MODE=false

if [[ "$1" == "--json" ]]; then
  JSON_MODE=true
fi

# Get connection status
STATUS_OUTPUT=$("$CONNECTA_CLI" status 2>/dev/null || echo "error")
if echo "$STATUS_OUTPUT" | grep -q "needs auth"; then
  CONN_STATUS="needs_auth"
elif echo "$STATUS_OUTPUT" | grep -q "connected"; then
  CONN_STATUS="connected"
elif echo "$STATUS_OUTPUT" | grep -q "no portal"; then
  CONN_STATUS="no_portal"
else
  CONN_STATUS="error"
fi

# Get gateway
GATEWAY=$(echo "$STATUS_OUTPUT" | grep "Gateway:" | awk '{print $2}' || echo "")

# Get interface
INTERFACE=$(echo "$STATUS_OUTPUT" | grep "Interface:" | awk '{print $2}' || echo "")

# Get hotspot status
HOTSPOT_ACTIVE=false
HOTSPOT_SSID=""
HOTSPOT_CLIENTS=0
if systemctl is-active --quiet create_ap 2>/dev/null; then
  HOTSPOT_ACTIVE=true
  HOTSPOT_SSID=$(grep "^SSID=" /etc/create_ap.conf 2>/dev/null | cut -d= -f2 || echo "")
  HOTSPOT_CLIENTS=$(iw dev ap0 station dump 2>/dev/null | grep -c "Station " || echo "0")
fi

# Get VPN status
VPN_CONNECTED=false
VPN_IP=""
VPN_IFACE="wg0"
if ip link show "$VPN_IFACE" &>/dev/null; then
  VPN_CONNECTED=true
  VPN_IP=$(ip -4 addr show "$VPN_IFACE" 2>/dev/null | grep "inet " | awk '{print $2}' || echo "")
fi

# Output JSON
cat <<EOF
{
  "connection": {
    "status": "$CONN_STATUS",
    "gateway": "$GATEWAY",
    "interface": "$INTERFACE"
  },
  "hotspot": {
    "active": $HOTSPOT_ACTIVE,
    "ssid": "$HOTSPOT_SSID",
    "clients": $HOTSPOT_CLIENTS
  },
  "vpn": {
    "connected": $VPN_CONNECTED,
    "ip": "$VPN_IP"
  },
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
