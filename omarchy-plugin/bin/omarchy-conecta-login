#!/bin/bash
# omarchy:summary=Login to ETECSA portal
# omarchy:args=[login|logout|speed|status]
# omarchy:hidden=true
#
# Thin adapter over conecta-cli: passes CLI stdout through verbatim and
# propagates its exit status unchanged. Never synthesizes success.
# Contract: one JSON document on stdout; diagnostics stay on stderr.

set -u

CONNECTA_CLI="${CONNECTA_CLI:-conecta-cli}"

usage_json() {
  printf '%s' '{"ok":false,"error":{"code":"invalid_input","message":"usage: omarchy-conecta-login {login|logout|speed|status}"}}'
}

ACTION="${1:-}"
case "$ACTION" in
  login|logout|speed|status) ;;
  *)
    echo "Usage: $0 {login|logout|speed|status}" >&2
    usage_json
    exit 2
    ;;
esac

# Passthrough with a guard: valid CLI output goes out verbatim with the CLI
# exit (success only on exit 0). A nonzero exit with empty/non-JSON stdout
# (crashed/missing CLI) still yields one failure document — never silence,
# never synthesized success. CLI stderr flows to our stderr (diagnostics),
# never to stdout; the decision uses stdout + exit code only.
out=$("$CONNECTA_CLI" "$ACTION"); rc=$?
if [ "$rc" -ne 0 ] && ! printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
  printf '{"ok":false,"error":{"code":"op_failed","message":"conecta-cli %s failed with exit %d"}}' "$ACTION" "$rc"
  exit "$rc"
fi
printf '%s' "$out"
exit "$rc"
